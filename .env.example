# Reticent AI Proxy Authentication Key
# Obtain this key from your Reticent AI Dashboard (https://dashboard.reticent.ai)
RETICENT_API_KEY=ret_live_dummy_placeholder_key_here

# Underlying LLM Provider API Key (OpenAI / Anthropic / Groq)
OPENAI_API_KEY=sk-proj-dummy_placeholder_key_here

# Reticent AI Proxy Base URL Endpoint
# Override the standard OpenAI API base URL to route requests through the Reticent Proxy
RETICENT_BASE_URL=https://your-reticent-proxy.onrender.com/api/v1
